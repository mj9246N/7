  data
) {

  const categories =
    Object.entries(
      data.categories || {}
    )
    .sort(
      (a, b) =>
        Number(b[1]) -
        Number(a[1])
    );


  const categoryRows =
    categories.length

      ?

      categories.map(
        ([name, count]) => {

          return `

<div class="category">

<span>
${escapeHTML(
  makeHashtag(name)
)}
</span>

<b>
${toEnglishDigits(count)}
</b>

</div>

`;

        }
      ).join("")

      :

