// ============================================================
// CONFIG
// ============================================================

const BOT_TOKEN = "YOUR_BOT_TOKEN";

const CHANNEL = "@TitrXFA";

const NEWS_API =
  "https://raw.githubusercontent.com/itsyebekhe/rasadai/main/news.json";

const ADMIN_PASSWORD = "CHANGE_THIS_PASSWORD";

// حداکثر خبر در هر اجرای Cron
const MAX_NEWS_PER_RUN = 7;

// فاصله بین ارسال خبرها
const SEND_DELAY_MS = 1800;

// حداکثر تلاش Telegram
const MAX_TELEGRAM_RETRIES = 5;

// قفل اجرای همزمان
const LOCK_SECONDS = 120;


// ============================================================
// HELPERS
// ============================================================

function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}


// ============================================================
// HTML ESCAPE
// ============================================================

function escapeHTML(value) {

  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");

}


// ============================================================
// ENGLISH DIGITS
// ============================================================

function toEnglishDigits(value) {

  return String(value ?? "")
    .replace(/[۰-۹]/g, d =>
      String("۰۱۲۳۴۵۶۷۸۹".indexOf(d))
    );

}


// ============================================================
// KV
// ============================================================

async function kvGet(env, key, fallback = null) {

  const value =
    await env.DB.get(key);

  return value === null
    ? fallback
    : value;

}


async function kvGetJSON(
  env,
  key,
  fallback
) {

  const value =
    await env.DB.get(key);

  if (!value) {
    return fallback;
  }

  try {

    return JSON.parse(value);

  } catch {

    return fallback;

  }

}


async function kvPut(
  env,
  key,
  value
) {

  await env.DB.put(
    key,
    String(value)
  );

}


async function kvPutJSON(
  env,
  key,
  value
) {

  await env.DB.put(
    key,
    JSON.stringify(value)
  );

}


// ============================================================
// TELEGRAM
// ============================================================

async function telegram(
  method,
  body
) {

  let attempt = 0;

  while (
    attempt < MAX_TELEGRAM_RETRIES
  ) {

    attempt++;

    const response =
      await fetch(
        `https://api.telegram.org/bot${BOT_TOKEN}/${method}`,
        {

          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body:
            JSON.stringify(body)

        }
      );


    let data;

    try {

      data =
        await response.json();

    } catch {

      throw new Error(
        `Telegram ${method}: پاسخ نامعتبر`
      );

    }


    if (data.ok) {

      return data.result;

    }


    // --------------------------------------------------------
    // Too Many Requests
    // --------------------------------------------------------

    if (
      response.status === 429
    ) {

      const retryAfter =
        Number(
          data.parameters?.retry_after || 10
        );

      console.log(
        `Telegram 429 - retry after ${retryAfter}s`
      );

      await sleep(
        (retryAfter + 1) * 1000
      );

      continue;

    }


    // --------------------------------------------------------
    // Message is not modified
    // --------------------------------------------------------

    if (
      String(
        data.description || ""
      )
      .toLowerCase()
      .includes(
        "message is not modified"
      )
    ) {

      return null;

    }


    throw new Error(
      `Telegram ${method}: ${
        data.description ||
        "Unknown error"
      }`
    );

  }


  throw new Error(
    `Telegram ${method}: retry limit exceeded`
  );

}


// ============================================================
// IMPORTANCE SQUARE
// ============================================================
//
// 9-10  → 🟥 بسیار مهم
// 7-8   → 🟧 مهم
// 5-6   → 🟨 متوسط
// 3-4   → 🟩 نسبتاً کم
// 0-2   → ⬜ کم
//
// ============================================================

function getUrgencySquare(value) {

  const n =
    Number(value);


  if (n >= 9)
    return "🟥";


  if (n >= 7)
    return "🟧";


  if (n >= 5)
    return "🟨";


  if (n >= 3)
    return "🟩";


  return "⬜";

}


// ============================================================
// IMPORTANCE TEXT
// ============================================================

function getUrgencyText(value) {

  const n =
    Number(value);


  if (n >= 9)
    return "بسیار مهم";


  if (n >= 7)
    return "مهم";


  if (n >= 5)
    return "متوسط";


  if (n >= 3)
    return "نسبتاً کم";


  return "کم";

}


// ============================================================
// SENTIMENT
// ============================================================

function getSentimentText(value) {

  const n =
    Number(value);


  if (n <= -0.7)
    return "بسیار منفی";


  if (n <= -0.3)
    return "منفی";


  if (n < 0.3)
    return "خنثی";


  if (n < 0.7)
    return "مثبت";


  return "بسیار مثبت";

}


// ============================================================
// SMART HASHTAG
// ============================================================
//
// دیپلماتیک-نظامی
//       ↓
// #دیپلماتیک_نظامی
//
// بین‌الملل
//       ↓
// #بین‌الملل
//
// نیابتی ها
//       ↓
// #نیابتی_ها
//
// ============================================================

function makeHashtag(tag) {

  if (
    tag === null ||
    tag === undefined
  ) {

    return "#خبر";

  }


  let value =
    String(tag).trim();


  // حذف # قبلی
  value =
    value.replace(
      /^#+/,
      ""
    );


  // انواع خط تیره → _
  value =
    value.replace(
      /[-‐-‒–—―﹘﹣－]/g,
      "_"
    );


  // فاصله → _
  value =
    value.replace(
      /\s+/g,
      "_"
    );


  // چند _ → یک _
  value =
    value.replace(
      /_+/g,
      "_"
    );


  // حفظ حروف فارسی، انگلیسی، اعداد، _
  // و نیم‌فاصله
  value =
    value.replace(
      /[^\p{L}\p{N}_\u200C]/gu,
      ""
    );


  value =
    value.replace(
      /^_+|_+$/g,
      ""
    );


  if (!value) {

    return "#خبر";

  }


  return "#" + value;

}


// ============================================================
// BUILD NEWS MESSAGE
// ============================================================

function buildNewsMessage(news) {

  if (
    !news.title_fa ||
    !String(news.title_fa).trim()
  ) {

    return null;

  }


  let text = "";


  // ----------------------------------------------------------
  // عنوان + مربع اهمیت
  // ----------------------------------------------------------

  const urgencySquare =
    getUrgencySquare(
      news.urgency
    );


  text +=
    `${urgencySquare} <b>${escapeHTML(
      news.title_fa
    )}</b>\n\n`;


  // ----------------------------------------------------------
  // متن خبر
  // ----------------------------------------------------------

  if (
    Array.isArray(news.summary)
  ) {

    const summaries =
      news.summary
        .filter(
          item =>
            item &&
            String(item).trim()
        )
        .map(
          item =>
            escapeHTML(item)
        );


    if (
      summaries.length
    ) {

      text +=
        summaries.join(
          "\n\n"
        );

      text +=
        "\n\n";

    }

  }


  // ----------------------------------------------------------
  // اثر - Quote
  // ----------------------------------------------------------

  if (
    news.impact &&
    String(news.impact).trim()
  ) {

    text +=
      `<blockquote>📌 اثر: ${
        escapeHTML(news.impact)
      }</blockquote>\n\n`;

  }


  // ----------------------------------------------------------
  // منبع
  //
  // فقط نام منبع Spoiler است
  //
  // 📰 منبع: The Atlantic
  //             ↑ فقط این قسمت Spoiler
  // ----------------------------------------------------------

  if (
    news.source &&
    String(news.source).trim()
  ) {

    text +=
      `📰 منبع: <tg-spoiler>${
        escapeHTML(news.source)
      }</tg-spoiler>\n\n`;

  }


  // ----------------------------------------------------------
  // هشتگ + اهمیت + جهت
  // ----------------------------------------------------------

  const hashtag =
    makeHashtag(
      news.tag
    );


  const urgency =
    getUrgencyText(
      news.urgency
    );


  const sentiment =
    getSentimentText(
      news.sentiment
    );


  text +=
    `<b>${hashtag}\n`;


  text +=
    `🚨 اهمیت: ${
      escapeHTML(urgency)
    }\n`;


  text +=
    `📊 جهت خبر: ${
      escapeHTML(sentiment)
    }</b>`;


  // ----------------------------------------------------------
  // لینک Image
  //
  // لینک کامل نمایش داده نمی‌شود.
  // Telegram در صورت پشتیبانی URL را Preview می‌کند.
  // ----------------------------------------------------------

  if (
    news.image &&
    String(news.image).trim()
  ) {

    text +=
      `\n\n<a href="${
        escapeHTML(news.image)
      }">🖼 Image</a>`;

  }


  return text;

}


// ============================================================
// SEND NEWS
// ============================================================

async function sendNews(news) {

  const text =
    buildNewsMessage(
      news
    );


  if (!text) {

    throw new Error(
      "عنوان فارسی خبر وجود ندارد"
    );

  }


  const body = {

    chat_id:
      CHANNEL,

    text:
      text,

    parse_mode:
      "HTML",

    disable_notification:
      false

  };


  // ----------------------------------------------------------
  // Image Preview
  // ----------------------------------------------------------

  if (
    news.image &&
    String(news.image).trim()
  ) {

    body.link_preview_options = {

      is_disabled:
        false,

      url:
        String(news.image),

      show_above_text:
        false,

      prefer_large_media:
        true

    };

  }


  return await telegram(
    "sendMessage",
    body
  );

}


// ============================================================
// FETCH NEWS API
// ============================================================

async function fetchNews() {

  const apiUrl =
    `${NEWS_API}?t=${Date.now()}`;


  const response =
    await fetch(
      apiUrl,
      {

        headers: {

          "User-Agent":
            "TitrXFA-Worker/1.0",

          "Cache-Control":
            "no-cache"

        },

        cf: {

          cacheTtl: 0,

          cacheEverything: false

        }

      }
    );


  if (!response.ok) {

    throw new Error(
      `News API HTTP ${response.status}`
    );

  }


  const data =
    await response.json();


  if (
    Array.isArray(data)
  ) {

    return data;

  }


  if (
    Array.isArray(data.news)
  ) {

    return data.news;

  }


  if (
    Array.isArray(data.data)
  ) {

    return data.data;

  }


  return [];

}


// ============================================================
// TIMESTAMP → UTC DATE
// ============================================================

function getUTCDateFromTimestamp(
  timestamp
) {

  const number =
    Number(timestamp);


  if (
    !Number.isFinite(number)
  ) {

    return null;

  }


  const date =
    new Date(
      number * 1000
    );


  if (
    Number.isNaN(
      date.getTime()
    )
  ) {

    return null;

  }


  return date
    .toISOString()
    .slice(
      0,
      10
    );

}


// ============================================================
// TODAY UTC
// ============================================================

function getTodayUTC() {

  return new Date()
    .toISOString()
    .slice(
      0,
      10
    );

}


// ============================================================
// CATEGORY MESSAGE
// ============================================================

function buildCategoryMessage(
  categories
) {

  const entries =
    Object.entries(
      categories || {}
    )
    .filter(
      ([, count]) =>
        Number(count) > 0
    )
    .sort(
      (a, b) => {

        const difference =
          Number(b[1]) -
          Number(a[1]);


        if (
          difference !== 0
        ) {

          return difference;

        }


        return String(a[0])
          .localeCompare(
            String(b[0]),
            "fa"
          );

      }
    );


  let text =
    "📊 <b>دسته‌بندی اخبار</b>\n\n";


  if (
    !entries.length
  ) {

    return (
      text +
      "هنوز خبری ثبت نشده است."
    );

  }


  for (
    const [
      tag,
      count
    ]
    of entries
  ) {

    const hashtag =
      makeHashtag(tag);


    text +=
      `<b>${hashtag} ${
        toEnglishDigits(count)
      }</b>\n`;

  }


  return text.trim();

}


// ============================================================
// CREATE CATEGORY MESSAGE
// ============================================================

async function createCategoryMessage(
  env,
  categories
) {

  const text =
    buildCategoryMessage(
      categories
    );


  const result =
    await telegram(
      "sendMessage",
      {

        chat_id:
          CHANNEL,

        text:
          text,

        parse_mode:
          "HTML",

        disable_web_page_preview:
          true

      }
    );


  if (
    !result?.message_id
  ) {

    throw new Error(
      "Telegram message_id برنگرداند"
    );

  }


  const messageId =
    result.message_id;


  await kvPut(
    env,
    "category_message_id",
    messageId
  );


  await kvPut(
    env,
    "category_message_link",
    `https://t.me/TitrXFA/${messageId}`
  );


  // ----------------------------------------------------------
  // فقط یک بار Pin
  // ----------------------------------------------------------

  try {

    await telegram(
      "pinChatMessage",
      {

        chat_id:
          CHANNEL,

        message_id:
          messageId,

        disable_notification:
          true

      }
    );


    await kvPut(
      env,
      "category_message_pinned",
      "true"
    );


  } catch (error) {

    console.error(
      "Pin failed:",
      error.message
    );


    await kvPut(
      env,
      "category_message_pinned",
      "false"
    );

  }


  return messageId;

}


// ============================================================
// ENSURE CATEGORY MESSAGE
// ============================================================

async function ensureCategoryMessage(
  env,
  categories
) {

  const existingId =
    await kvGet(
      env,
      "category_message_id"
    );


  if (
    existingId
  ) {

    return Number(
      existingId
    );

  }


  return await createCategoryMessage(
    env,
    categories
  );

}


// ============================================================
// UPDATE CATEGORY MESSAGE
// ============================================================

async function updateCategoryMessage(
  env,
  categories
) {

  const messageId =
    await ensureCategoryMessage(
      env,
      categories
    );


  const text =
    buildCategoryMessage(
      categories
    );


  try {

    await telegram(
      "editMessageText",
      {

        chat_id:
          CHANNEL,

        message_id:
          Number(messageId),

        text:
          text,

        parse_mode:
          "HTML",

        disable_web_page_preview:
          true

      }
    );


  } catch (error) {

    const message =
      String(
        error.message || ""
      )
      .toLowerCase();


    // --------------------------------------------------------
    // پیام حذف شده یا قابل ویرایش نیست
    // --------------------------------------------------------

    if (
      message.includes(
        "message to edit not found"
      ) ||
      message.includes(
        "message can't be edited"
      )
    ) {

      await env.DB.delete(
        "category_message_id"
      );


      await env.DB.delete(
        "category_message_link"
      );


      await env.DB.delete(
        "category_message_pinned"
      );


      await createCategoryMessage(
        env,
        categories
      );


      return;

    }


    throw error;

  }

}


// ============================================================
// LOCK
// ============================================================

async function acquireLock(
  env
) {

  const old =
    await env.DB.get(
      "sync_lock"
    );


  if (old) {

    const age =
      Date.now() -
      Number(old);


    if (
      age <
      LOCK_SECONDS * 1000
    ) {

      return false;

    }

  }


  await env.DB.put(
    "sync_lock",
    String(Date.now()),
    {

      expirationTtl:
        LOCK_SECONDS

    }
  );


  return true;

}


async function releaseLock(
  env
) {

  await env.DB.delete(
    "sync_lock"
  );

}


// ============================================================
// PROCESS NEWS
// ============================================================

async function processNews(
  env
) {

  const locked =
    await acquireLock(
      env
    );


  if (!locked) {

    return {

      ok: false,

      locked: true,

      message:
        "یک Sync دیگر در حال اجراست."

    };

  }


  try {

    // --------------------------------------------------------
    // API
    // --------------------------------------------------------

    const allNews =
      await fetchNews();


    if (!allNews.length) {

      return {

        ok: true,

        found: 0,

        today: 0,

        sent: 0

      };

    }


    // --------------------------------------------------------
    // امروز UTC
    // --------------------------------------------------------

    const todayUTC =
      getTodayUTC();


    // --------------------------------------------------------
    // فقط اخبار امروز
    // --------------------------------------------------------

    const todayNews =
      allNews
        .filter(item => {

          if (
            !item ||
            !item.id ||
            !item.timestamp
          ) {

            return false;

          }


          const newsDate =
            getUTCDateFromTimestamp(
              item.timestamp
            );


          return (
            newsDate ===
            todayUTC
          );

        })
        .sort(
          (a, b) =>
            Number(
              a.timestamp || 0
            ) -
            Number(
              b.timestamp || 0
            )
        );


    // --------------------------------------------------------
    // اخبار ارسال شده
    // --------------------------------------------------------

    const sentIds =
      await kvGetJSON(
        env,
        "sent_news_ids",
        []
      );


    const sentSet =
      new Set(
        sentIds.map(
          id =>
            String(id)
        )
      );


    // --------------------------------------------------------
    // دسته‌ها
    // --------------------------------------------------------

    const categories =
      await kvGetJSON(
        env,
        "categories",
        {}
      );


    // --------------------------------------------------------
    // فقط ۷ خبر جدید امروز
    // --------------------------------------------------------

    const newNews =
      todayNews
        .filter(
          item =>
            !sentSet.has(
              String(item.id)
            )
        )
        .filter(
          item =>
            item.title_fa &&
            String(
              item.title_fa
            ).trim()
        )
        .slice(
          0,
          MAX_NEWS_PER_RUN
        );


    let sentCount = 0;


    // --------------------------------------------------------
    // ارسال خبرها
    // --------------------------------------------------------

    for (
      const news
      of newNews
    ) {

      const id =
        String(news.id);


      if (
        sentSet.has(id)
      ) {

        continue;

      }


      try {

        await sendNews(
          news
        );


        // ----------------------------------------------------
        // فقط پس از ارسال موفق
        // ----------------------------------------------------

        sentSet.add(id);


        let ids =
          Array.from(
            sentSet
          );


        if (
          ids.length > 5000
        ) {

          ids =
            ids.slice(
              -5000
            );

        }


        await kvPutJSON(
          env,
          "sent_news_ids",
          ids
        );


        // ----------------------------------------------------
        // دسته‌بندی
        // ----------------------------------------------------

        const tag =
          String(
            news.tag ||
            "سایر"
          ).trim();


        if (
          !Object.prototype.hasOwnProperty
            .call(
              categories,
              tag
            )
        ) {

          categories[tag] =
            0;

        }


        categories[tag] =
          Number(
            categories[tag]
          ) + 1;


        await kvPutJSON(
          env,
          "categories",
          categories
        );


        sentCount++;


        await sleep(
          SEND_DELAY_MS
        );


      } catch (error) {

        console.error(
          `Failed news ${id}:`,
          error.message
        );


        // ID ذخیره نمی‌شود
        // در اجرای بعد دوباره تلاش خواهد شد

        continue;

      }

    }


    // --------------------------------------------------------
    // پیام دسته‌بندی
    // --------------------------------------------------------

    await updateCategoryMessage(
      env,
      categories
    );


    const now =
      new Date().toISOString();


    await kvPut(
      env,
      "last_sync",
      now
    );


    await kvPutJSON(
      env,
      "last_sync_result",
      {

        utcDate:
          todayUTC,

        totalApiNews:
          allNews.length,

        todayNews:
          todayNews.length,

        candidates:
          newNews.length,

        sent:
          sentCount,

        time:
          now

      }
    );


    return {

      ok: true,

      utcDate:
        todayUTC,

      totalApiNews:
        allNews.length,

      todayNews:
        todayNews.length,

      candidates:
        newNews.length,

      sent:
        sentCount

    };


  } finally {

    await releaseLock(
      env
    );

  }

}


// ============================================================
// AUTH
// ============================================================

function authorized(
  request
) {

  const url =
    new URL(
      request.url
    );


  const password =
    url.searchParams.get(
      "password"
    );


  return (
    password ===
    ADMIN_PASSWORD
  );

}


