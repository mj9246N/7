location.search
);


const password =
params.get(
"password"
);


button.disabled =
true;


status.textContent =
"⏳ در حال بررسی اخبار امروز UTC...";


try {


const response =
await fetch(
"/api/sync?password=" +
encodeURIComponent(
password || ""
)
);


const data =
await response.json();


if (
data.locked
) {

status.textContent =
"⏳ Sync دیگری در حال اجراست.";

button.disabled =
false;

return;

}


if (
!data.ok
) {

throw new Error(
data.error ||
"خطا"
);

}


status.textContent =
"✅ انجام شد — ارسال: " +
data.sent;


setTimeout(
() => location.reload(),
1200
);


} catch(error) {


status.textContent =
"❌ " +
error.message;


button.disabled =
false;

}

}

