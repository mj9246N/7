  'برنامه خاموشی برنامه‌ریزی شده',
  'خاموشی جاری',
  'برنامه خاموشی‌ها'
];

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    if (request.method === 'GET' && url.pathname === '/logs') {
      return serveLogs();
    }
    if (request.method === 'POST') {
      return handleNotification(request, env);
    }
    return new Response('Not Found', { status: 404 });
  }
};

async function handleNotification(request, env) {
  addLog(`[${new Date().toISOString()}] POST received`);

  if (request.headers.get('X-API-Key') !== SECRET_TOKEN) {
    addLog('Unauthorized request');
    return new Response('Forbidden', { status: 403 });
  }

  let body;
  try {
    body = await request.json();
    addLog(`Payload: ${JSON.stringify(body)}`);
  } catch (e) {
    addLog('Invalid JSON');
    return new Response('Bad Request', { status: 400 });
  }

  const text = body.text || '';
  const rawTime = body.time;

  if (!OUTAGE_KEYWORDS.some(keyword => text.includes(keyword))) {
    addLog('Skipped: no outage keywords');
    return new Response('OK', { status: 200 });
  }

  const outageData = extractOutageData(text);
  const dedupKey = generateDedupKey(outageData);

  const existing = await env.OUTAGE_KV.get(dedupKey);
  if (existing) {
    addLog(`Duplicate event, skipped (key: ${dedupKey})`);
    return new Response('OK', { status: 200 });
  }
  await env.OUTAGE_KV.put(dedupKey, '1', { expirationTtl: 86400 });

  // 1. ارسال به تلگرام (MarkdownV2)
  const tgMessage = buildTelegramMessage(outageData, rawTime);
  addLog('Sending to Telegram');
  await sendToTelegram(tgMessage);

  // 2. ارسال به روبیکا (متن ساده)
  const rubikaMessage = buildPlainText(outageData, rawTime);
  addLog('Sending to Rubika');
  await sendToRubika(rubikaMessage);

  return new Response('OK', { status: 200 });
}

async function sendToTelegram(text) {
  const tgUrl = `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`;
  try {
    const tgResp = await fetch(tgUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        chat_id: TELEGRAM_CHAT_ID,
        text: text,
        parse_mode: 'MarkdownV2'
      })
    });
    if (tgResp.ok) {
      addLog('Sent to Telegram successfully');
    } else {
      addLog(`Telegram error: ${await tgResp.text()}`);
    }
  } catch (e) {
    addLog(`Telegram fetch error: ${e.message}`);
  }
}

async function sendToRubika(plainText) {
  const rubikaUrl = `https://botapi.rubika.ir/v3/${RUBIKA_BOT_TOKEN}/sendMessage`;
  try {
    const rubikaResp = await fetch(rubikaUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        chat_id: RUBIKA_CHAT_ID,
        text: plainText,
      })
    });
    if (rubikaResp.ok) {
      addLog('Sent to Rubika successfully');
    } else {
      addLog(`Rubika error: ${await rubikaResp.text()}`);
    }
  } catch (e) {
    addLog(`Rubika fetch error: ${e.message}`);
  }
}

// ========== توابع استخراج ==========
function extractOutageData(rawText) {
  let startIndex = -1;
  for (const marker of START_MARKERS) {
    const idx = rawText.indexOf(marker);
    if (idx !== -1 && (startIndex === -1 || idx < startIndex)) {
      startIndex = idx;
    }
  }
  if (startIndex !== -1) {
    rawText = rawText.substring(startIndex);
  }

  const lines = rawText.split('\n').map(l => l.trim()).filter(l => l.length > 0);

  let company = '', region = '', dateValue = '', startTime = '', endTime = '', reason = '';
  let isScheduled = rawText.includes('خاموشی برنامه‌ریزی شده') || rawText.includes('برنامه خاموشی برنامه‌ریزی شده');

  for (const line of lines) {
    if (line.startsWith('شرکت توزیع نیروی برق:')) company = line;
    else if (line.startsWith('منطقه/امور برق:')) region = line;
    else if (line.startsWith('تاریخ احتمالی قطع برق:')) {
      dateValue = line.replace('تاریخ احتمالی قطع برق:', '').trim();
    }
    else if (line.startsWith('تاریخ قطع برق:')) {
      dateValue = line.replace('تاریخ قطع برق:', '').trim();
    }
    else if (line.startsWith('ساعت شروع قطع برق:')) startTime = line.replace('ساعت شروع قطع برق:', '').trim();
    else if (line.startsWith('ساعت پایان قطع برق:')) endTime = line.replace('ساعت پایان قطع برق:', '').trim();
    else if (line.startsWith('علت قطع برق:')) reason = line.replace('علت قطع برق:', '').trim();
  }

  return {
    company,
    region,
    dateValue,
    startTime,
    endTime,
    reason,
    isScheduled
  };
}

function generateDedupKey(data) {
  return `outage:${data.dateValue}:${data.startTime}:${data.endTime}:${data.reason}`;
}

// ========== ساخت پیام تلگرام (MarkdownV2) ==========
function buildTelegramMessage(data, rawTime) {
  const lines = [];

  // عنوان بر اساس نوع اعلان
  const title = data.isScheduled
    ? 'برنامه خاموشی برنامه‌ریزی‌شده'
    : 'خاموشی جاری';
  lines.push(`>⚡ ${escapeMd(title)}`);

  if (data.company) lines.push(escapeMd(data.company));
  if (data.region) lines.push(escapeMd(data.region));

  lines.push(escapeMd('شهرستان: شادگان'));
  lines.push(`بخش: *${escapeMd('خنافره – مسیر جنوبی')}*`);

  // برای هر دو نوع، برچسب‌ها با «احتمالی» و بولد شدن آن
  lines.push(`📅 تاریخ *${escapeMd('احتمالی')}* قطع برق: ${escapeMd(data.dateValue)}`);
  lines.push(`🕗 ساعت *${escapeMd('احتمالی')}* شروع: ${escapeMd(data.startTime)}`);
  lines.push(`🕙 ساعت *${escapeMd('احتمالی')}* پایان: ${escapeMd(data.endTime)}`);
  lines.push(`🔧 *علت اعلام‌شده:* ${escapeMd(data.reason)}`);

  const mainText = lines.join('\n');

  // لینک‌ها
  const link1 = escapeMd('https://t.me/BarghKhanafere');
  const link2 = escapeMd('https://rubika.ir/BarghKhanafere');
  const links = `📱 ||${link1}||\n📱 ||${link2}||`;

  const dateStr = formatDate(rawTime);
  const dateLine = dateStr ? `\n\`${escapeMd(dateStr)}\`` : '';

  return `${mainText}\n${links}${dateLine}`;
}

// ========== ساخت متن ساده برای روبیکا ==========
function buildPlainText(data, rawTime) {
  const lines = [];

  const title = data.isScheduled
    ? '⚡ برنامه خاموشی برنامه‌ریزی‌شده'
    : '⚡ خاموشی جاری';
  lines.push(title);

  if (data.company) lines.push(data.company);
