  lines.push('شهرستان: شادگان');
  lines.push('بخش: خنافره – مسیر جنوبی');

  lines.push(`📅 تاریخ احتمالی قطع برق: ${data.dateValue}`);
  lines.push(`🕗 ساعت احتمالی شروع: ${data.startTime}`);
  lines.push(`🕙 ساعت احتمالی پایان: ${data.endTime}`);
  lines.push(`🔧 علت اعلام‌شده: ${data.reason}`);

  const dateStr = formatDate(rawTime);
  const links = '\nhttps://t.me/BarghKhanafere\nhttps://rubika.ir/BarghKhanafere';
  return lines.join('\n') + links + (dateStr ? `\n${dateStr}` : '');
}

// ========== Escape MarkdownV2 ==========
function escapeMd(text) {
  return text.replace(/([_*[\]()~`>#+\-=|{}.!])/g, '\\$1');
}

// ========== تبدیل timestamp به تاریخ فارسی ==========
function formatDate(timestamp) {
  if (!timestamp) return '';
  try {
    const ts = parseInt(timestamp);
    if (isNaN(ts)) return '';
    const date = new Date(ts);
    try {
      return date.toLocaleDateString('fa-IR', { year: 'numeric', month: '2-digit', day: '2-digit' });
    } catch (e) {
      return `${date.getFullYear()}/${String(date.getMonth()+1).padStart(2,'0')}/${String(date.getDate()).padStart(2,'0')}`;
    }
  } catch (e) {
    return '';
  }
}

// ========== توابع جانبی ==========
function serveLogs() {
  const html = `<!DOCTYPE html>
<html dir="rtl">
<head><meta charset="UTF-8"><title>Worker Logs</title>
<style>
  body { background:#1e1e1e; color:#d4d4d4; font-family:monospace; padding:1rem; }
  pre { white-space:pre-wrap; word-wrap:break-word; }
  .log-line { border-bottom:1px solid #333; padding:2px 0; }
  button { padding: 0.5rem 1rem; margin-bottom:1rem; }
</style></head>
<body>
  <button onclick="fetch('/logs').then(r=>r.text()).then(t=>document.body.innerHTML=t)">🔄 بروزرسانی</button>
  <pre>${LOGS.map(line => `<div class="log-line">${esc(line)}</div>`).join('') || 'بدون لاگ'}</pre>
</body>
</html>`;
  return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
}

function addLog(message) {
  LOGS.push(message);
  if (LOGS.length > MAX_LOGS) LOGS.shift();
}

function esc(s) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
