// ======================================================
// RECEIVE FROM ANDROID
// ======================================================

async function handleNotification(
  request,
  env
) {

  addLog(
    'درخواست POST دریافت شد: ' +
    request.url
  );

  if (
    request.headers.get('X-API-Key') !==
    SECRET_TOKEN
  ) {

    addLog(
      'خطا: کلید امنیتی نامعتبر'
    );

    return new Response(
      'Forbidden',
      {
        status:403
      }
    );
  }

  let body;

  try {

    body =
      await request.json();

    addLog(
      'JSON دریافت شد: ' +
      JSON.stringify(body)
    );

  } catch(e) {

    addLog(
      'خطا: JSON نامعتبر'
    );

    return new Response(
      'Bad Request',
      {
        status:400
      }
    );
  }

  const message = {

    id:
      crypto.randomUUID(),

    app:
      body.app ||
      'Unknown',

    package:
      body.package ||
      '',

    title:
      body.title ||
      '',

    text:
      body.text ||
      '',

    time:
      body.time ||
      '',

    battery:
      body.battery != null
        ? body.battery
        : null,

    receivedAt:
      Date.now(),

    status:
      'new'
  };

  try {

    await env.PANEL_KV.put(
      `msg:${message.id}`,
      JSON.stringify(message),
      {
        expirationTtl:
          MESSAGE_TTL
      }
    );

    addLog(
      `پیام در KV ذخیره شد: ${message.id}`
    );

  } catch(e) {

    addLog(
      `خطا در ذخیره KV: ${e.message}`
    );

    return new Response(
      'KV Error',
      {
        status:500
      }
    );
  }

  try {

    await updateDisplayList(
      env,
      message.id
    );

  } catch(e) {

    addLog(
      `خطا در displayList: ${e.message}`
    );

    return new Response(
      'KV Error',
      {
        status:500
      }
    );
  }

  return new Response(
    'OK',
    {
      status:200
    }
  );
}

// ======================================================
// DISPLAY LIST
// ======================================================

async function updateDisplayList(
  env,
  newId
) {

  const key =
    'displayList';

  const existingStr =
    await env.PANEL_KV.get(key);

  let list =
    existingStr
      ? JSON.parse(existingStr)
      : [];

  list =
    list.filter(
      id => id !== newId
    );

  list.unshift(newId);

  list =
    list.slice(
      0,
      MAX_DISPLAY
    );

  await env.PANEL_KV.put(
    key,
    JSON.stringify(list)
  );
}

// ======================================================
// API
// ======================================================

async function handleApi(
  request,
  env
) {

  const url =
    new URL(request.url);

  const path =
    url.pathname;

  const method =
    request.method;

  // ==================================================
  // GET MESSAGES
  // ==================================================

  if (
    path === '/api/messages' &&
    method === 'GET'
  ) {

    const refresh =
      await checkDailyRefresh(env);

    if (!refresh.allowed) {

      return new Response(
        JSON.stringify({

          error:
            'daily_limit',

          message:
            'سقف ۳۰ بار دریافت پیام در ۲۴ ساعت استفاده شده است.',

          count:
            refresh.count,

          limit:
            MAX_DAILY_REFRESH,

          resetAt:
            refresh.resetAt,

          remainingSeconds:
            Math.max(
              0,
              Math.ceil(
                (
                  refresh.resetAt -
                  Date.now()
                ) / 1000
              )
            )

        }),
        {
          status:429,

          headers:{
            'Content-Type':
              'application/json',

            'Cache-Control':
              'no-store',

            'X-Refresh-Count':
              String(refresh.count),

            'X-Refresh-Limit':
              String(MAX_DAILY_REFRESH),

            'X-Refresh-Reset':
              String(refresh.resetAt)
          }
        }
      );
    }

    try {

      const response =
        await getMessages(env);

      response.headers.set(
        'X-Refresh-Count',
        String(refresh.count)
      );

      response.headers.set(
        'X-Refresh-Limit',
        String(MAX_DAILY_REFRESH)
      );

      response.headers.set(
        'X-Refresh-Reset',
        String(refresh.resetAt)
      );

      response.headers.set(
        'Cache-Control',
        'no-store'
      );

      return response;

    } catch(e) {

      addLog(
        'خطا getMessages: ' +
        e.message
      );

      return new Response(
        'Error',
        {
          status:500
        }
      );
    }
  }

  // ==================================================
  // MARK READ
  // ==================================================

  if (
    path === '/api/mark-read' &&
    method === 'POST'
  ) {

    const { id } =
      await request
        .json()
        .catch(() => ({}));

    if (!id) {

      return new Response(
        'Bad Request',
        {
          status:400
        }
      );
    }

    try {

      await markRead(
        env,
        id
      );

      return new Response(
        JSON.stringify({
          success:true
        }),
        {
          headers:{
            'Content-Type':
              'application/json'
          }
        }
      );

    } catch(e) {

      return new Response(
        'Error',
        {
          status:500
        }
      );
    }
  }

  // ==================================================
  // DELETE
  // ==================================================

  if (
    path === '/api/delete' &&
    method === 'POST'
  ) {

    const { id } =
      await request
        .json()
        .catch(() => ({}));

    if (!id) {

      return new Response(
        'Bad Request',
        {
          status:400
        }
      );
    }

    try {

      await deleteMessage(
        env,
        id
      );

      return new Response(
        JSON.stringify({
          success:true
        }),
        {
          headers:{
            'Content-Type':
              'application/json'
          }
        }
      );

    } catch(e) {

      return new Response(
        'Error',
        {
          status:500
        }
      );
    }
  }

  return new Response(
    'Not Found',
    {
      status:404
    }
  );
}

// ======================================================
// DAILY REFRESH COUNTER
// ======================================================

async function checkDailyRefresh(
  env
) {

  const key =
    'dailyRefreshCounter';

  const now =
    Date.now();

  let data = null;

  try {

    const stored =
      await env.PANEL_KV.get(key);

    if (stored) {
      data =
        JSON.parse(stored);
    }

  } catch(e) {

    addLog(
      'خطا در خواندن شمارنده: ' +
      e.message
    );
  }

  // اگر شمارنده وجود ندارد
  // یا بازه 24 ساعته تمام شده
  if (
    !data ||
    !data.resetAt ||
    now >= data.resetAt
  ) {

    data = {

      count:0,

      resetAt:
        now +
        (
          REFRESH_WINDOW *
          1000
        )
    };
  }

  // رسیدن به سقف
  if (
    data.count >=
    MAX_DAILY_REFRESH
  ) {

    return {

      allowed:false,

      count:
        data.count,

      resetAt:
        data.resetAt
    };
  }

  // یک بار مصرف می‌شود
  data.count += 1;

  await env.PANEL_KV.put(
    key,
    JSON.stringify(data),
    {
      expirationTtl:
        REFRESH_WINDOW
    }
  );

  return {

    allowed:true,

    count:
      data.count,

    resetAt:
      data.resetAt
  };
}

// ======================================================
// GET MESSAGES
// ======================================================

async function getMessages(
  env
) {

  const listStr =
    await env.PANEL_KV.get(
      'displayList'
    );

  if (!listStr) {

    return new Response(
      JSON.stringify([]),
      {
        headers:{
          'Content-Type':
            'application/json'
        }
      }
    );
  }

  const ids =
    JSON.parse(listStr);

  const messages = [];

  for (
    const id of ids
  ) {

    const msgStr =
      await env.PANEL_KV.get(
        `msg:${id}`
      );

    if (msgStr) {

      messages.push(
        JSON.parse(msgStr)
      );
    }
  }

  messages.sort(
    (a,b) =>
      (b.receivedAt || 0) -
      (a.receivedAt || 0)
  );

  return new Response(
    JSON.stringify(messages),
    {
      headers:{
        'Content-Type':
          'application/json'
      }
    }
  );
}

// ======================================================
// MARK READ
// ======================================================

async function markRead(
  env,
  id
) {

  const msgStr =
    await env.PANEL_KV.get(
      `msg:${id}`
    );

  if (!msgStr) {
    return;
  }

  const msg =
    JSON.parse(msgStr);

  if (
    msg.status !== 'read'
  ) {

    msg.status =
      'read';

    await env.PANEL_KV.put(
      `msg:${id}`,
      JSON.stringify(msg),
      {
        expirationTtl:
          MESSAGE_TTL
      }
    );
  }
}

// ======================================================
// DELETE
// ======================================================

async function deleteMessage(
  env,
  id
) {

  await env.PANEL_KV.delete(
    `msg:${id}`
  );

  const listStr =
    await env.PANEL_KV.get(
      'displayList'
    );

  if (listStr) {

    let list =
      JSON.parse(listStr);

    list =
      list.filter(
        item =>
          item !== id
      );

    await env.PANEL_KV.put(
      'displayList',
      JSON.stringify(list)
    );
  }
}

