  display:flex;

  flex-direction:column;

  gap:.8rem;
}

.message-card {

  background:white;

  border-radius:.8rem;

  padding:1rem;

  box-shadow:
    0 2px 8px rgba(0,0,0,.05);

  border:1px solid #e0e0e0;
}

.message-app {

  font-weight:bold;

  font-size:.9rem;

  color:#2563eb;

  margin-bottom:.4rem;
}

.message-title {

  font-weight:bold;

  font-size:1rem;

  color:#111;

  margin-bottom:.3rem;
}

.message-text {

  white-space:pre-wrap;

  word-break:break-word;

  font-size:1.05rem;

  font-weight:600;

  color:#333;

  margin-bottom:.5rem;
}

.message-meta {

  border-top:1px solid #ddd;

  padding-top:.4rem;

  margin-top:.4rem;

  font-size:.9rem;

  font-weight:600;

  color:#555;

  display:flex;

  flex-wrap:wrap;

  gap:.5rem;
}

</style>

</head>

<body>

<div class="header">

<h1>پیام‌ها</h1>

<button
onclick="loadMessages()"
style="
background:#2563eb;
color:white;
border:none;
padding:.5rem 1rem;
border-radius:.5rem;
cursor:pointer;
">

🔄 بروزرسانی

</button>

<a
class="logout"
href="${PANEL_PATH}/logout">

خروج

</a>

</div>

<div class="refresh-info">

🔄 تعداد دریافت پیام:

<span
id="refresh-count"
class="refresh-count">

0 / 30

</span>

<div
id="refresh-warning"
class="refresh-warning">
</div>

</div>

<div
class="messages-container"
id="messages-list">
</div>

<script>

function formatTimeField(
  timeValue
) {

  if (!timeValue)
    return '';

  const ts =
    Number(timeValue);

  if (!isNaN(ts)) {

    try {

      return new Date(ts)
        .toLocaleString(
          'en-US',
          {
            timeZone:
              'Asia/Tehran',

            year:'numeric',

            month:'2-digit',

            day:'2-digit',

            hour:'2-digit',

            minute:'2-digit'
          }
        );

    } catch(e) {}
  }

  return timeValue;
}

// ==================================================
// FORMAT REMAINING TIME
// ==================================================

function formatRemaining(
  seconds
) {

  seconds =
    Math.max(
      0,
      Number(seconds) || 0
    );

  const hours =
    Math.floor(
      seconds / 3600
    );

  const minutes =
    Math.floor(
      (seconds % 3600) / 60
    );

  const secs =
    seconds % 60;

  return (
    hours +
    ' ساعت و ' +
    minutes +
    ' دقیقه و ' +
    secs +
    ' ثانیه'
  );
}

// ==================================================
// LOAD MESSAGES
// ==================================================

async function loadMessages() {

  const countElement =
    document.getElementById(
      'refresh-count'
    );

  const warningElement =
    document.getElementById(
      'refresh-warning'
    );

  try {

    const res =
      await fetch(
        '/api/messages',
        {
          cache:'no-store'
        }
      );

    const limit =
      res.headers.get(
        'X-Refresh-Limit'
      ) || '30';

    const count =
      res.headers.get(
        'X-Refresh-Count'
      );

    if (count !== null) {

      countElement.textContent =
        count +
        ' / ' +
        limit;
    }

    // ================================================
    // LIMIT REACHED
    // ================================================

    if (
      res.status === 429
    ) {

      const data =
        await res.json();

      warningElement.style.display =
        'block';

      warningElement.innerHTML =
        '⚠️ سقف ۳۰ بار دریافت پیام در این بازه ۲۴ ساعته استفاده شده است.' +
        '<br><br>' +
        '⏳ زمان باقی‌مانده: ' +
        formatRemaining(
          data.remainingSeconds
        );

      return;
    }

    if (!res.ok) {

      throw new Error(
        'خطا در دریافت پیام‌ها'
      );
    }

    const data =
      await res.json();

    const container =
      document.getElementById(
        'messages-list'
      );

    container.innerHTML =
      '';

    warningElement.style.display =
      'none';

    // ================================================
    // SHOW MESSAGES
    // ================================================

    data.forEach(
      msg => {

        const card =
          document.createElement(
            'div'
          );

        card.className =
          'message-card';

        const app =
          document.createElement(
            'div'
          );

        app.className =
          'message-app';

        app.textContent =
          msg.app ||
          'Unknown';

        const title =
          document.createElement(
            'div'
          );

        title.className =
          'message-title';

        title.textContent =
          msg.title ||
          '';

        const text =
          document.createElement(
            'div'
          );

        text.className =
          'message-text';

        text.textContent =
          msg.text ||
          '';

        const meta =
          document.createElement(
            'div'
          );

        meta.className =
          'message-meta';

        // ----------------------------------------------
        // MESSAGE TIME
        // ----------------------------------------------

        if (msg.time) {

          const timeSpan =
            document.createElement(
              'span'
            );

          timeSpan.textContent =
            '📅 ' +
            formatTimeField(
              msg.time
            );

          meta.appendChild(
            timeSpan
          );
        }

        // ----------------------------------------------
        // RECEIVED TIME
        // ----------------------------------------------

        if (msg.receivedAt) {

          const recvSpan =
            document.createElement(
              'span'
            );

          const date =
            new Date(
              msg.receivedAt
            )
            .toLocaleString(
              'en-US',
              {
                timeZone:
                  'Asia/Tehran',

                year:'numeric',

                month:'2-digit',

                day:'2-digit',

                hour:'2-digit',

                minute:'2-digit'
              }
            );

          recvSpan.textContent =
            '🕒 ' +
            date;

          meta.appendChild(
            recvSpan
          );
        }

        // ----------------------------------------------
        // BATTERY
        // ----------------------------------------------

        if (
          msg.battery != null
        ) {

          const battSpan =
            document.createElement(
              'span'
            );

          battSpan.textContent =
            '🔋 ' +
            msg.battery +
            '%';

          meta.appendChild(
            battSpan
          );
        }

        card.appendChild(
          app
        );

        card.appendChild(
          title
        );

        card.appendChild(
          text
        );

        card.appendChild(
          meta
        );

        container.appendChild(
          card
        );
      }
    );

  } catch(e) {

    console.error(e);

    warningElement.style.display =
      'block';

    warningElement.textContent =
      '❌ خطا در دریافت پیام‌ها';
  }
}

// ==================================================
// INITIAL LOAD
// ==================================================

loadMessages();

</script>

</body>

</html>`;
}
