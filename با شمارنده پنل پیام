const SECRET_TOKEN = 'amiraliamiri777';

const PANEL_PATH = '/sms/android';

const MESSAGE_TTL = 518400; // 6 روز
const MAX_DISPLAY = 33;
const MAX_LOGS = 200;

// حداکثر 30 بار دریافت پیام توسط پنل در هر 24 ساعت
const MAX_DAILY_REFRESH = 30;
const REFRESH_WINDOW = 86400;

const LOGS = [];

// ======================================================
// HTML ESCAPE
// ======================================================

function esc(s) {
  return String(s ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

// ======================================================
// LOGS
// ======================================================

function addLog(message) {
  const timestamp = new Date().toLocaleString('en-US', {
    timeZone: 'Asia/Tehran'
  });

  LOGS.push(`[${timestamp}] ${message}`);

  if (LOGS.length > MAX_LOGS) {
    LOGS.shift();
  }
}

// ======================================================
// MAIN WORKER
// ======================================================

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;

    // ==================================================
    // TEST PAGE
    // ==================================================

    if (
      path === '/test' &&
      request.method === 'GET'
    ) {
      return serveTestPage();
    }

    // ==================================================
    // LOGS
    // ==================================================

    if (
      path === '/logs' &&
      request.method === 'GET'
    ) {
      return serveLogs();
    }

    // ==================================================
    // LOGIN PAGE
    // ==================================================

    if (
      path === PANEL_PATH &&
      request.method === 'GET'
    ) {
      return serveLoginPage();
    }

    // ==================================================
    // LOGIN POST
    // ==================================================

    if (
      path === PANEL_PATH + '/login' &&
      request.method === 'POST'
    ) {
      return handlePanelLogin(request, env);
    }

    // ==================================================
    // PANEL
    // ==================================================

    if (
      path === PANEL_PATH + '/panel' &&
      request.method === 'GET'
    ) {

      if (!(await isAuthenticated(request, env))) {
        return Response.redirect(
          new URL(
            PANEL_PATH,
            request.url
          ).toString(),
          302
        );
      }

      return servePanel();
    }

    // ==================================================
    // LOGOUT
    // ==================================================

    if (
      path === PANEL_PATH + '/logout' &&
      request.method === 'GET'
    ) {

      return new Response(null, {
        status: 302,

        headers: {
          'Location': PANEL_PATH,

          'Set-Cookie':
            'panel_auth=; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=0'
        }
      });
    }

    // ==================================================
    // API
    // ==================================================

    if (path.startsWith('/api/')) {

      if (!(await isAuthenticated(request, env))) {

        return new Response(
          'Unauthorized',
          {
            status: 401
          }
        );
      }

      return handleApi(
        request,
        env
      );
    }

    // ==================================================
    // ANDROID NOTIFICATION
    // ==================================================

    if (
      request.method === 'POST' &&
      path === '/'
    ) {
      return handleNotification(
        request,
        env
      );
    }

    return new Response(
      'Not Found',
      {
        status: 404
      }
    );
  }
};

