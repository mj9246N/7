// ======================================================
// AUTH CHECK
// ======================================================

async function isAuthenticated(
  request,
  env
) {

  try {

    const cookie =
      request.headers.get('Cookie') || '';

    const match =
      cookie.match(
        /(?:^|;\s*)panel_auth=([^;]+)/
      );

    if (!match) {
      return false;
    }

    const token =
      match[1];

    const value =
      await env.PANEL_KV.get(
        `session:${token}`
      );

    return value === '1';

  } catch (e) {

    return false;
  }
}

