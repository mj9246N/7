// ============================================================
// WORKER
// ============================================================

export default {

  async fetch(
    request,
    env,
    ctx
  ) {

    const url =
      new URL(
        request.url
      );


    // --------------------------------------------------------
    // Dashboard
    // --------------------------------------------------------

    if (
      url.pathname === "/"
    ) {

      if (
        !authorized(request)
      ) {

        return new Response(
          "Unauthorized",
          {
            status: 401
          }
        );
      }


      return dashboard(
        env,
        request
      );
    }


    // --------------------------------------------------------
    // Manual Sync
    // --------------------------------------------------------

    if (
      url.pathname === "/api/sync"
    ) {

      if (
        !authorized(request)
      ) {

        return new Response(

          JSON.stringify({
            ok: false,
            error: "Unauthorized"
          }),

          {
            status: 401,

            headers: {
              "Content-Type":
                "application/json"
            }
          }
        );
      }


      try {

        const result =
          await processNews(
            env
          );


        return new Response(

          JSON.stringify(
            result
          ),

          {
            headers: {
              "Content-Type":
                "application/json"
            }
          }
        );

      } catch (error) {

        console.error(
          error
        );


        return new Response(

          JSON.stringify({

            ok: false,

            error:
              error.message

          }),

          {

            status: 500,

            headers: {
              "Content-Type":
                "application/json"
            }

          }
        );
      }
    }


    // --------------------------------------------------------
    // Health
    // --------------------------------------------------------

    if (
      url.pathname === "/health"
    ) {

      return new Response(

        JSON.stringify({

          ok: true,

          bot:
            "TitrXFA",

          channel:
            CHANNEL,

          utc:
            new Date()
              .toISOString()

        }),

        {

          headers: {
            "Content-Type":
              "application/json"
          }

        }
      );
    }


    return new Response(
      "TitrXFA Worker",
      {
        status: 404
      }
    );
  },


  // ==========================================================
  // CRON
  // ==========================================================

  async scheduled(
    event,
    env,
    ctx
  ) {

    ctx.waitUntil(
      processNews(env)
    );
  }

};
