const BOT_TOKEN = "YOUR_BOT_TOKEN";
const CHANNEL = "@TitrXFA";

const NEWS_API =
  "https://raw.githubusercontent.com/itsyebekhe/rasadai/main/news.json";

const ADMIN_PASSWORD = "CHANGE_THIS_PASSWORD";

const MAX_NEWS_PER_RUN = 7;
const SEND_DELAY_MS = 1800;
const MAX_TELEGRAM_RETRIES = 5;

const STATE_KEY = "STATE";
const LOCK_KEY = "LOCK";


// ============================================================
// BASIC HELPERS
// ============================================================

function sleep(ms) {
  return new Promise(function (resolve) {
    setTimeout(resolve, ms);
  });
}


function escapeHTML(value) {
  return String(value == null ? "" : value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}


function toEnglishDigits(value) {
  return String(value == null ? "" : value)
    .replace(/[۰-۹]/g, function (d) {
      return String("۰۱۲۳۴۵۶۷۸۹".indexOf(d));
    });
}


function parseJSON(value, fallback) {
  if (!value) {
    return fallback;
  }

  try {
    return JSON.parse(value);
  } catch (e) {
    return fallback;
  }
}


// ============================================================
// DEFAULT STATE
// ============================================================

function defaultState() {
  return {
    version: 2,

    sentNewsIds: [],

    categories: {},

    categoryMessageId: null,

    categoryMessagePinned: false,

    lastSync: null,

    lastSyncResult: null,

    migrated: false
  };
}


// ============================================================
// KV - LOAD STATE + AUTOMATIC MIGRATION
// ============================================================

async function loadState(env) {

  // ----------------------------------------------------------
  // First try new STATE
  // ----------------------------------------------------------

  const stateRaw = await env.DB.get(STATE_KEY);

  if (stateRaw) {

    const parsed = parseJSON(
      stateRaw,
      null
    );

    if (parsed) {

      const base = defaultState();

      base.version =
        Number(parsed.version || 2);

      base.sentNewsIds =
        Array.isArray(parsed.sentNewsIds)
          ? parsed.sentNewsIds.map(function (id) {
              return String(id);
            })
          : [];

      base.categories =
        parsed.categories &&
        typeof parsed.categories === "object" &&
        !Array.isArray(parsed.categories)
          ? parsed.categories
          : {};

      base.categoryMessageId =
        parsed.categoryMessageId
          ? Number(parsed.categoryMessageId)
          : null;

      base.categoryMessagePinned =
        parsed.categoryMessagePinned === true;

      base.lastSync =
        parsed.lastSync || null;

      base.lastSyncResult =
        parsed.lastSyncResult || null;

      base.migrated =
        parsed.migrated === true;

      return base;
    }
  }


  // ----------------------------------------------------------
  // OLD DATA MIGRATION
  // ----------------------------------------------------------

  const state = defaultState();


  // Old sent_news_ids
  const oldSentRaw =
    await env.DB.get("sent_news_ids");

  const oldSent =
    parseJSON(
      oldSentRaw,
      []
    );


  if (Array.isArray(oldSent)) {

    state.sentNewsIds =
      oldSent
        .map(function (id) {
          return String(id);
        })
        .slice(-5000);
  }


  // Old categories
  const oldCategoriesRaw =
    await env.DB.get("categories");

  const oldCategories =
    parseJSON(
      oldCategoriesRaw,
      {}
    );


  if (
    oldCategories &&
    typeof oldCategories === "object" &&
    !Array.isArray(oldCategories)
  ) {

    state.categories =
      oldCategories;
  }


  // Old category message ID
  const oldMessageId =
    await env.DB.get("category_message_id");


  if (oldMessageId) {

    const messageId =
      Number(oldMessageId);

    if (Number.isFinite(messageId)) {
      state.categoryMessageId =
        messageId;
    }
  }


  // Old pinned state
  const oldPinned =
    await env.DB.get(
      "category_message_pinned"
    );


  if (oldPinned === "true") {
    state.categoryMessagePinned = true;
  }


  state.migrated = true;


  // ----------------------------------------------------------
  // ONE NEW STATE WRITE
  // ----------------------------------------------------------

  await env.DB.put(
    STATE_KEY,
    JSON.stringify(state)
  );


  console.log(
    "Automatic KV migration completed."
  );


  return state;
}


// ============================================================
// SAVE STATE
// ============================================================

async function saveState(env, state) {

  await env.DB.put(
    STATE_KEY,
    JSON.stringify(state)
  );
}


// ============================================================
// TELEGRAM API
// ============================================================

async function telegram(method, body) {

  for (
    let attempt = 1;
    attempt <= MAX_TELEGRAM_RETRIES;
    attempt++
  ) {

    const response =
      await fetch(
        "https://api.telegram.org/bot" +
        BOT_TOKEN +
        "/" +
        method,
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body:
            JSON.stringify(body)
        }
      );


    const data =
      await response.json();


    if (data.ok) {
      return data.result;
    }


    // --------------------------------------------------------
    // Telegram 429
    // --------------------------------------------------------

    if (response.status === 429) {

      const retryAfter =
        Number(
          data.parameters &&
          data.parameters.retry_after
            ? data.parameters.retry_after
            : 10
        );


      if (
        attempt >=
        MAX_TELEGRAM_RETRIES
      ) {

        throw new Error(
          "Telegram rate limit exceeded"
        );
      }


      console.log(
        "Telegram 429. Retry after " +
        retryAfter +
        " seconds."
      );


      await sleep(
        (retryAfter + 1) * 1000
      );


      continue;
    }


    const description =
      String(
        data.description || ""
      );


    if (
      description
        .toLowerCase()
        .includes(
          "message is not modified"
        )
    ) {

      return null;
    }


    throw new Error(
      description ||
      "Telegram API error"
    );
  }


  throw new Error(
    "Telegram API error"
  );
}


// ============================================================
// IMPORTANCE
// ============================================================

function getUrgencySquare(value) {

  const n =
    Number(value) || 0;


  if (n >= 9) {
    return "🟥";
  }

  if (n >= 7) {
    return "🟧";
  }

  if (n >= 5) {
    return "🟨";
  }

  if (n >= 3) {
    return "🟩";
  }

  return "⬜";
}


function getUrgencyText(value) {

  const n =
    Number(value) || 0;


  if (n >= 9) {
    return "بسیار مهم";
  }

  if (n >= 7) {
    return "مهم";
  }

  if (n >= 5) {
    return "متوسط";
  }

  if (n >= 3) {
    return "نسبتاً کم";
  }

  return "کم";
}


// ============================================================
// SENTIMENT
// ============================================================

function getSentimentText(value) {

  const n =
    Number(value) || 0;


  if (n <= -0.7) {
    return "بسیار منفی";
  }

  if (n <= -0.3) {
    return "منفی";
  }

  if (n < 0.3) {
    return "خنثی";
  }

  if (n < 0.7) {
    return "مثبت";
  }

  return "بسیار مثبت";
}


// ============================================================
// SMART HASHTAG NORMALIZATION
// ============================================================

function makeHashtag(tag) {

  let value =
    String(
      tag == null ? "" : tag
    ).trim();


  // Remove #
  value =
    value.replace(
      /^#+/,
      ""
    );


  // Remove zero-width characters
  value =
    value.replace(
      /[\u200B\u200C\u200D\uFEFF]/g,
      ""
    );


  // Arabic/Persian variations
  value =
    value.replace(
      /ي/g,
      "ی"
    );

  value =
    value.replace(
      /ى/g,
      "ی"
    );

  value =
    value.replace(
      /ك/g,
      "ک"
    );


  // All types of dash -> underscore
  value =
    value.replace(
      /[-‐-‒–—―﹘﹣－]/g,
      "_"
    );


  // Spaces -> underscore
  value =
    value.replace(
      /\s+/g,
      "_"
    );


  // Remove remaining punctuation
  value =
    value.replace(
      /[^\p{L}\p{N}_]/gu,
      ""
    );


  // Multiple underscores
  value =
    value.replace(
      /_+/g,
      "_"
    );


  // Trim underscores
  value =
    value.replace(
      /^_+|_+$/g,
      ""
    );


  if (!value) {
    return "#خبر";
  }


  return "#" + value;
}


// ============================================================
// NEWS MESSAGE
// ============================================================

function buildNewsMessage(news) {

  if (
    !news ||
    !news.title_fa ||
    !String(news.title_fa).trim()
  ) {

    return null;
  }


  const square =
    getUrgencySquare(
      news.urgency
    );


  let text =
    square +
    " <b>" +
    escapeHTML(
      news.title_fa
    ) +
    "</b>\n\n";


  // ----------------------------------------------------------
  // Persian text only
  // ----------------------------------------------------------

  if (
    Array.isArray(news.summary)
  ) {

    const summaries =
      news.summary
        .filter(function (item) {

          return (
            item &&
            String(item).trim()
          );
        })
        .map(function (item) {

          return escapeHTML(
            item
          );
        });


    if (
      summaries.length > 0
    ) {

      text +=
        summaries.join(
          "\n\n"
        );

      text +=
        "\n\n";
    }
  }


  // ----------------------------------------------------------
  // Impact
  // ----------------------------------------------------------

  if (
    news.impact &&
    String(news.impact).trim()
  ) {

    text +=
      "<blockquote>📌 اثر: " +
      escapeHTML(
        news.impact
      ) +
      "</blockquote>\n\n";
  }


  // ----------------------------------------------------------
  // Source
  // Only source name is spoiler
  // ----------------------------------------------------------

  if (
    news.source &&
    String(news.source).trim()
  ) {

    text +=
      "📰 منبع: " +
      "<tg-spoiler>" +
      escapeHTML(
        news.source
      ) +
      "</tg-spoiler>\n\n";
  }


  // ----------------------------------------------------------
  // Hashtag / importance / direction
  // ----------------------------------------------------------

  const hashtag =
    makeHashtag(
      news.tag
    );


  const urgency =
    getUrgencyText(
      news.urgency
    );


  const sentiment =
    getSentimentText(
      news.sentiment
    );


  text +=
    "<b>" +
    hashtag +
    "\n" +
    "🚨 اهمیت: " +
    escapeHTML(
      urgency
    ) +
    "\n" +
    "📊 جهت خبر: " +
    escapeHTML(
      sentiment
    ) +
    "</b>";


  // ----------------------------------------------------------
  // Image as hyperlink
  // ----------------------------------------------------------

  if (
    news.image &&
    String(news.image).trim()
  ) {

    text +=
      "\n\n<a href=\"" +
      escapeHTML(
        news.image
      ) +
      "\">🖼 مشاهده تصویر</a>";
  }


  return text;
}


// ============================================================
// SEND NEWS
// ============================================================

async function sendNews(news) {

  const text =
    buildNewsMessage(
      news
    );


  if (!text) {

    throw new Error(
      "خبر فاقد عنوان فارسی است."
    );
  }


  const body = {

    chat_id:
      CHANNEL,

    text:
      text,

    parse_mode:
      "HTML",

    link_preview_options:
      {
        is_disabled:
          true
      }
  };


  return telegram(
    "sendMessage",
    body
  );
}


// ============================================================
// FETCH API
// ============================================================

async function fetchNews() {

  const response =
    await fetch(
      NEWS_API +
      "?t=" +
      Date.now(),
      {
        method: "GET",

        headers: {
          "Cache-Control":
            "no-cache"
        },

        cf: {
          cacheTtl: 0
        }
      }
    );


  if (!response.ok) {

    throw new Error(
      "API HTTP " +
      response.status
    );
  }


  const data =
    await response.json();


  if (Array.isArray(data)) {
    return data;
  }


  if (
    data &&
    Array.isArray(data.news)
  ) {

    return data.news;
  }


  if (
    data &&
    Array.isArray(data.data)
  ) {

    return data.data;
  }


  return [];
}


// ============================================================
// UTC DATE
// ============================================================

function timestampDateUTC(timestamp) {

  const n =
    Number(timestamp);


  if (!Number.isFinite(n)) {
    return null;
  }


  const date =
    new Date(
      n * 1000
    );


  if (
    Number.isNaN(
      date.getTime()
    )
  ) {

    return null;
  }


  return date
    .toISOString()
    .slice(0, 10);
}


function todayUTC() {

  return new Date()
    .toISOString()
    .slice(0, 10);
}


// ============================================================
// CATEGORY MESSAGE
// ============================================================

function buildCategoryMessage(categories) {

  const popular =
    Object.entries(
      categories || {}
    )
    .map(function (entry) {

      return {

        name:
          String(entry[0]),

        count:
          Number(entry[1]) || 0

      };
    })
    .filter(function (item) {

      return item.count >= 17;
    })
    .sort(function (a, b) {

      if (
        b.count !==
        a.count
      ) {

        return (
          b.count -
          a.count
        );
      }


      return a.name.localeCompare(
        b.name,
        "fa"
      );
    });


  let text =
    "📊 <b>دسته‌بندی اخبار — هشتگ‌های پرکاربرد</b>\n\n";


  if (
    popular.length === 0
  ) {

    text +=
      "<i>هنوز هشتگی به ۱۷ خبر نرسیده است.</i>";

    return text;
  }


  popular.forEach(function (item) {

    text +=
      "<b>" +
      escapeHTML(
        makeHashtag(
          item.name
        )
      ) +
      "</b>  " +
      "<b>" +
      toEnglishDigits(
        item.count
      ) +
      "</b>\n";

  });


  return text.trim();
}


// ============================================================
// CREATE CATEGORY MESSAGE
// ============================================================

async function createCategoryMessage(
  env,
  state
) {

  const result =
    await telegram(
      "sendMessage",
      {

        chat_id:
          CHANNEL,

        text:
          buildCategoryMessage(
            state.categories
          ),

        parse_mode:
          "HTML",

        link_preview_options:
          {
            is_disabled:
              true
          }
      }
    );


  if (
    !result ||
    !result.message_id
  ) {

    throw new Error(
      "Category message was not created."
    );
  }


  state.categoryMessageId =
    Number(
      result.message_id
    );


  state.categoryMessagePinned =
    false;


  // ----------------------------------------------------------
  // Pin only once
  // ----------------------------------------------------------

  try {

    await telegram(
      "pinChatMessage",
      {

        chat_id:
          CHANNEL,

        message_id:
          Number(
            result.message_id
          ),

        disable_notification:
          true
      }
    );


    state.categoryMessagePinned =
      true;

  } catch (error) {

    console.error(
      "Pin failed:",
      error.message
    );
  }
}


// ============================================================
// EDIT CATEGORY MESSAGE
// ============================================================

async function editCategoryMessage(
  state
) {

  if (
    !state.categoryMessageId
  ) {

    return false;
  }


  try {

    await telegram(
      "editMessageText",
      {

        chat_id:
          CHANNEL,

        message_id:
          Number(
            state.categoryMessageId
          ),

        text:
          buildCategoryMessage(
            state.categories
          ),

        parse_mode:
          "HTML",

        link_preview_options:
          {
            is_disabled:
              true
          }
      }
    );


    return true;

  } catch (error) {

    const message =
      String(
        error.message || ""
      ).toLowerCase();


    if (
      message.includes(
        "message is not modified"
      )
    ) {

      return true;
    }


    if (
      message.includes(
        "message to edit not found"
      ) ||
      message.includes(
        "message can't be edited"
      )
    ) {

      state.categoryMessageId =
        null;

      state.categoryMessagePinned =
        false;

      return false;
    }


    throw error;
  }
}


// ============================================================
// CATEGORY COUNTER
// ============================================================

function increaseCategory(
  state,
  tag
) {

  const raw =
    String(
      tag == null
        ? ""
        : tag
    ).trim();


  if (!raw) {
    return;
  }


  // Keep original category internally,
  // normalized form is used when displayed.
  if (
    !Object.prototype.hasOwnProperty.call(
      state.categories,
      raw
    )
  ) {

    state.categories[raw] =
      0;
  }


  state.categories[raw] =
    (Number(
      state.categories[raw]
    ) || 0) + 1;
}


// ============================================================
// LOCK
// ============================================================

async function acquireLock(env) {

  const current =
    await env.DB.get(
      LOCK_KEY
    );


  if (current) {

    const created =
      Number(current);


    if (
      Number.isFinite(created)
    ) {

      const age =
        Date.now() -
        created;


      if (
        age >= 0 &&
        age < 120000
      ) {

        return false;
      }
    }
  }


  await env.DB.put(
    LOCK_KEY,
    String(
      Date.now()
    ),
    {
      expirationTtl:
        120
    }
  );


  return true;
}


async function releaseLock(env) {

  try {

    await env.DB.delete(
      LOCK_KEY
    );

  } catch (error) {

    console.error(
      "Lock release failed:",
      error.message
    );
  }
}


// ============================================================
// MAIN SYNC
// ============================================================

async function processNews(env) {

  const locked =
    await acquireLock(
      env
    );


  if (!locked) {

    return {

      ok: false,

      locked: true,

      message:
        "یک Sync دیگر در حال اجراست."

    };
  }


  try {

    // --------------------------------------------------------
    // Load STATE
    // --------------------------------------------------------

    const state =
      await loadState(
        env
      );


    // --------------------------------------------------------
    // Fetch API
    // --------------------------------------------------------

    const allNews =
      await fetchNews();


    // --------------------------------------------------------
    // Current UTC day
    // --------------------------------------------------------

    const today =
      todayUTC();


    // --------------------------------------------------------
    // Sent IDs in memory
    // --------------------------------------------------------

    const sent =
      new Set(
        state.sentNewsIds.map(
          function (id) {
            return String(id);
          }
        )
      );


    // --------------------------------------------------------
    // Only today's news
    // --------------------------------------------------------

    const todayNews =
      allNews
        .filter(function (news) {

          if (
            !news ||
            !news.id ||
            !news.timestamp
          ) {

            return false;
          }


          return (
            timestampDateUTC(
              news.timestamp
            ) === today
          );
        })
        .sort(function (a, b) {

          return (
            Number(
              a.timestamp || 0
            ) -
            Number(
              b.timestamp || 0
            )
          );
        });


    // --------------------------------------------------------
    // Maximum 7 NEW news per cron
    // --------------------------------------------------------

    const pending =
      todayNews
        .filter(function (news) {

          return !sent.has(
            String(news.id)
          );
        })
        .filter(function (news) {

          return (
            news.title_fa &&
            String(
              news.title_fa
            ).trim()
          );
        })
        .slice(
          0,
          MAX_NEWS_PER_RUN
        );


    let sentCount = 0;
    let failedCount = 0;


    // --------------------------------------------------------
    // Send
    // --------------------------------------------------------

    for (
      let i = 0;
      i < pending.length;
      i++
    ) {

      const news =
        pending[i];


      const id =
        String(
          news.id
        );


      if (
        sent.has(id)
      ) {

        continue;
      }


      try {

        await sendNews(
          news
        );


        // Only mark as sent AFTER Telegram success
        sent.add(id);


        increaseCategory(
          state,
          news.tag
        );


        sentCount++;


        if (
          i <
          pending.length - 1
        ) {

          await sleep(
            SEND_DELAY_MS
          );
        }

      } catch (error) {

        failedCount++;


        console.error(
          "News " +
          id +
          " failed:",
          error.message
        );
      }
    }


    // --------------------------------------------------------
    // Keep last 5000 IDs
    // --------------------------------------------------------

    state.sentNewsIds =
      Array.from(
        sent
      ).slice(-5000);


    // --------------------------------------------------------
    // Category message
    // --------------------------------------------------------

    if (
      state.categoryMessageId
    ) {

      const edited =
        await editCategoryMessage(
          state
        );


      if (!edited) {

        await createCategoryMessage(
          env,
          state
        );
      }

    } else {

      await createCategoryMessage(
        env,
        state
      );
    }


    // --------------------------------------------------------
    // Save metadata
    // --------------------------------------------------------

    state.lastSync =
      new Date()
        .toISOString();


    state.lastSyncResult = {

      utcDate:
        today,

      totalApiNews:
        allNews.length,

      todayNews:
        todayNews.length,

      pending:
        pending.length,

      sent:
        sentCount,

      failed:
        failedCount
    };


    // --------------------------------------------------------
    // ONE main KV WRITE
    // --------------------------------------------------------

    await saveState(
      env,
      state
    );


    return {

      ok: true,

      utcDate:
        today,

      totalApiNews:
        allNews.length,

      todayNews:
        todayNews.length,

      pending:
        pending.length,

      sent:
        sentCount,

      failed:
        failedCount,

      migrated:
        state.migrated === true

    };

  } finally {

    await releaseLock(
      env
    );
  }
}


// ============================================================
// AUTH
// ============================================================

function authorized(request) {

  const url =
    new URL(
      request.url
    );


  return (
    url.searchParams.get(
      "password"
    ) ===
    ADMIN_PASSWORD
  );
}


