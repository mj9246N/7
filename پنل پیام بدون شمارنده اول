// ======================================================
// LOGIN HANDLER
// ======================================================

async function handlePanelLogin(request, env) {

  const form =
    await request.formData();

  const password =
    form.get('password');

  const panelPassword =
    env.PANEL_PASSWORD;

  if (
    !panelPassword ||
    typeof password !== 'string' ||
    password !== panelPassword
  ) {

    return new Response(
      getLoginErrorHTML(),
      {
        status:401,
        headers:{
          'Content-Type':
            'text/html; charset=utf-8'
        }
      }
    );
  }

  const token =
    crypto.randomUUID();

  const cookieValue =
    `panel_auth=${token}; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=86400`;

  await env.PANEL_KV.put(
    `session:${token}`,
    '1',
    {
      expirationTtl:86400
    }
  );

  return new Response(null, {
    status:302,

    headers:{
      'Location':
        PANEL_PATH + '/panel',

      'Set-Cookie':
        cookieValue
    }
  });
}

