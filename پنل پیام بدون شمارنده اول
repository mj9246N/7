// ======================================================
// HTML ESCAPE
// ======================================================

function esc(s) {
  return String(s ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

// ======================================================
// LOGS
// ======================================================

function addLog(message) {
  const timestamp = new Date().toLocaleString('en-US', {
    timeZone: 'Asia/Tehran'
  });

  LOGS.push(`[${timestamp}] ${message}`);

  if (LOGS.length > MAX_LOGS) {
    LOGS.shift();
  }
}

// ======================================================
// MAIN WORKER
// ======================================================

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;

    // ==================================================
    // TEST PAGE
    // ==================================================

    if (path === '/test' && request.method === 'GET') {
      return serveTestPage();
    }

    // ==================================================
    // LOGS
    // ==================================================

    if (path === '/logs' && request.method === 'GET') {

      // لاگ‌ها فقط بعد از ورود قابل مشاهده باشند
      if (!(await isAuthenticated(request, env))) {
        return new Response('Unauthorized', {
          status: 401
        });
      }

      return serveLogs();
    }

    // ==================================================
    // LOGIN PAGE
    // ==================================================

    if (path === PANEL_PATH && request.method === 'GET') {
      return serveLoginPage();
    }

    // ==================================================
    // LOGIN POST
    // ==================================================

    if (
      path === PANEL_PATH + '/login' &&
      request.method === 'POST'
    ) {
      return handlePanelLogin(request, env);
    }

    // ==================================================
    // PANEL
    // ==================================================

    if (
      path === PANEL_PATH + '/panel' &&
      request.method === 'GET'
    ) {

      // مهم: await اضافه شده
      if (!(await isAuthenticated(request, env))) {
        return Response.redirect(
          new URL(PANEL_PATH, request.url).toString(),
          302
        );
      }

      return servePanel();
    }

    // ==================================================
    // LOGOUT
    // ==================================================

    if (
      path === PANEL_PATH + '/logout' &&
      request.method === 'GET'
    ) {

      return new Response(null, {
        status: 302,
        headers: {
          'Location': PANEL_PATH,
          'Set-Cookie':
            'panel_auth=; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=0'
        }
      });
    }

    // ==================================================
    // PANEL API
    // ==================================================

    if (path.startsWith('/api/')) {

      // مهم: await اضافه شده
      if (!(await isAuthenticated(request, env))) {
        return new Response('Unauthorized', {
          status: 401
        });
      }

      return handleApi(request, env);
    }

    // ==================================================
    // ANDROID NOTIFICATION
    // ==================================================
    //
    // این قسمت عمداً بدون PANEL_PASSWORD است.
    // اندروید با SECRET_TOKEN احراز هویت می‌شود.
    //
    // بنابراین ورود به پنل روی دریافت پیام تأثیری ندارد.
    // ==================================================

    if (
      request.method === 'POST' &&
      path === '/'
    ) {
      return handleNotification(request, env);
    }

    return new Response('Not Found', {
      status: 404
    });
  }
};

