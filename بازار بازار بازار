    const now = new Date().toLocaleTimeString("fa-IR", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Asia/Tehran",
    });
    const text = `⚠️ خطا در دریافت قیمت‌ها\n\nعلت:\n${msg}\n\nزمان: ${now}`;
    try { await sendTelegram(text); } catch (e) { console.error("send error failed:", e); }
    await kv.put("error_status", msg);
  }
}
