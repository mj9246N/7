    }

    return new Response("Commodity Price Worker Running ✅", {
      status: 200,
      headers: { "Content-Type": "text/plain; charset=utf-8" },
    });
  },
};

// ─── فرآیند کالاهای اصلی ────────────────────────────────────
async function processCommodities(env) {
  const kv = env[KV_NAMESPACE];

  let data;
  try {
    data = await fetchAllCommodities();
  } catch (e) {
    await handleError(kv, e.message);
    return;
  }

  const currentHash = JSON.stringify(data);
  const lastHash = (await kv.get("last_hash")) || "";

  if (currentHash === lastHash) {
    const prevErr = await kv.get("error_status");
    if (prevErr) {
      await sendRecovery();
      await kv.put("error_status", "");
    }
    return;
  }

  const message = formatMessage(data);
  await sendTelegram(message, { parse_mode: "HTML", disable_web_page_preview: true });
  await kv.put("last_hash", currentHash);

  const prevErr = await kv.get("error_status");
  if (prevErr) {
    await sendRecovery();
    await kv.put("error_status", "");
  }
}

