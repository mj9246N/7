  },

  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    if (url.searchParams.get("run") === "cron") {
      try {
        await processCommodities(env);
        await processMetals(env);
        return new Response("Manual cron executed: messages sent ✅", { status: 200 });
      } catch (err) {
