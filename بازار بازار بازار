      result[item.name] = { price: null, changePercent: null };
    }
  }
  return result;
}

// ─── تابع عمومی Yahoo Finance ──────────────────────────────
async function fetchCommodity(symbol) {
  const url = `https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(symbol)}?interval=1d&range=1d`;
  const res = await fetch(url, {
    headers: { "User-Agent": "Mozilla/5.0 (compatible; CommodityBot/1.0)" },
  });
  if (!res.ok) throw new Error(`Yahoo HTTP ${res.status}`);
  const json = await res.json();
  const meta = json?.chart?.result?.[0]?.meta;
  if (!meta) throw new Error("No meta data");

  const price = meta.regularMarketPrice;
  const prevClose = meta.chartPreviousClose || meta.previousClose;
  if (price == null || prevClose == null) throw new Error("Missing price or previous close");

  const change = price - prevClose;
  const changePercent = (change / prevClose) * 100;

  return {
    price: price.toFixed(2),
    changePercent: changePercent.toFixed(2),
  };
}

// ─── تابع عمومی TradingEconomics ───────────────────────────
async function fetchTradingEconomics(slug) {
  const url = `https://tradingeconomics.com/commodity/${slug}`;
  const res = await fetch(url, {
    headers: {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "en-US,en;q=0.5",
      "Referer": "https://tradingeconomics.com/",
    },
  });
  if (!res.ok) throw new Error(`TradingEconomics HTTP ${res.status}`);
  const html = await res.text();

  const priceMatch = html.match(/id\s*=\s*["']market_last["'][^>]*>\s*([\d,]+\.?\d*)/i);
  const pctMatch = html.match(/id\s*=\s*["']market_daily_Pchg["'][^>]*>\s*([+-]?[\d.]+)\s*%/i);

  if (priceMatch && pctMatch) {
    return {
      price: priceMatch[1].replace(/,/g, ""),
      changePercent: pctMatch[1],
    };
  }

  const descMatch = html.match(/rose to ([\d,]+\.?\d*)/i);
  if (descMatch) {
    return {
      price: descMatch[1].replace(/,/g, ""),
      changePercent: null,
    };
  }

  throw new Error(`Could not parse ${slug} data`);
}

// ─── دیباگ HTML TradingEconomics ───────────────────────────
async function getTradingEconomicsSnippet(slug) {
  const url = `https://tradingeconomics.com/commodity/${slug}`;
  const res = await fetch(url, {
    headers: {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "en-US,en;q=0.5",
      "Referer": "https://tradingeconomics.com/",
    },
  });
  if (!res.ok) throw new Error(`TradingEconomics HTTP ${res.status}`);
  const html = await res.text();
  const idx = html.indexOf("market_last");
  if (idx !== -1) {
    return html.substring(Math.max(0, idx - 500), idx + 1500);
  }
  const idx2 = html.indexOf("market_daily_Pchg");
  if (idx2 !== -1) {
    return html.substring(Math.max(0, idx2 - 500), idx2 + 1500);
  }
  return "IDs not found in HTML";
}

// ─── قالب‌بندی پیام کالاها (با واحد و تغییر صفر) ────────────
function formatMessage(data) {
  let text = "<b>💰 Live Commodity Prices</b>\n\n";
  for (const item of COMMODITIES) {
    const d = data[item.name];
    if (!d || !d.price) {
      text += `${item.emoji} <b>${item.name}</b>: N/A\n\n`;
      continue;
    }

    const change = d.changePercent;
    const changeNum = parseFloat(change);

    text += `${item.emoji} <b>${item.name}</b>\n`;
    text += `<blockquote>${d.price} ${item.unit}</blockquote>\n`;

    if (changeNum === 0 || change === "0.00" || change === "0") {
      text += `◻️ 0.00%\n\n`;
    } else {
      const isNegative = change.startsWith("-");
      const emojiTrend = isNegative ? "📉" : "📈";
      const changeDisplay = change.startsWith("+") || change.startsWith("-") ? change : "+" + change;
      text += `${emojiTrend} ${changeDisplay}%\n\n`;
    }
  }
  text += `📡 <a href="https://t.me/AUTObotbotlink7">https://t.me/AUTObotbotlink7</a>`;
  return text.trim();
}

