async function fetchAllCommodities() {
  const result = {};
  for (const item of COMMODITIES) {
    try {
      if (item.name === "Canola") {
        result[item.name] = await fetchTradingEconomics("canola");
      } else {
        result[item.name] = await fetchCommodity(item.symbol);
      }
    } catch (e) {
      console.error(`Error fetching ${item.symbol || item.name}:`, e.message);
      result[item.name] = { price: null, changePercent: null };
    }
  }
  return result;
}

