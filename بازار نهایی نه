function sleep(ms) {

  return new Promise(
    resolve =>
      setTimeout(
        resolve,
        ms
      )
  );

}


function getError(error) {

  if (
    error instanceof Error
  ) {

    return error.message;

  }

  return String(error);

}


function jsonResponse(data) {

  return new Response(
    JSON.stringify(
      data,
      null,
      2
    ),
    {
      status: 200,

      headers: {
        "Content-Type":
          "application/json; charset=utf-8"
      }
    }
  );

}
