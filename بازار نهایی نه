// ============================================================
// FORMAT COMMODITIES
// ============================================================

function formatMessage(data) {

  let text =
    "<b>💰 Live Commodity Prices</b>\n\n";


  for (
    const item of COMMODITIES
  ) {

    const d =
      data[item.name];


    if (
      !d ||
      d.price == null ||
      Number(d.price) <= 0
    ) {

      text +=
        `${item.emoji} <b>${item.name}</b>: N/A\n\n`;

      continue;

    }


    const change =
      String(
        d.changePercent ?? "0"
      );


    const trend =
      change.startsWith("-")
        ? "📉"
        : "📈";


    const display =
      change.startsWith("-") ||
      change.startsWith("+")
        ? change
        : "+" + change;


    text +=
      `${item.emoji} <b>${item.name}</b>\n`;

    text +=
      `<blockquote>${d.price} USD</blockquote>\n`;

    text +=
      `${trend} ${display}%\n\n`;

  }


  text +=
    `📡 <a href="https://t.me/AUTObotbotlink7">https://t.me/AUTObotbotlink7</a>`;


  return text.trim();

}


