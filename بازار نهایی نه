// ============================================================
// METALS ERROR
// ============================================================

async function handleErrorMetals(
  env,
  kv,
  message
) {

  const old =
    await kv.get(
      "error_status_metals"
    );


  if (old === message) {
    return;
  }


  const now =
    new Date()
      .toLocaleTimeString(
        "fa-IR",
        {
          hour: "2-digit",
          minute: "2-digit",
          timeZone: "Asia/Tehran"
        }
      );


  try {

    await sendTelegram(
      env,
      `⚠️ خطا در دریافت فلزات\n\n` +
      `علت:\n${message}\n\n` +
      `زمان: ${now}`
    );

  } catch (error) {

    console.error(
      "Telegram error:",
      error
    );

  }


  await kv.put(
    "error_status_metals",
    message
  );

}


