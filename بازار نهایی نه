// ============================================================
// CANOLA (TradingEconomics) - روش اصلی و دقیق
// ============================================================

async function fetchCanolaFromTradingEconomics() {

  const response =
    await fetch(
      "https://tradingeconomics.com/commodity/canola",
      {
        headers: {
          "User-Agent":
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120 Safari/537.36",

          "Accept":
            "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",

          "Accept-Language":
            "en-US,en;q=0.5"
        }
      }
    );


  if (!response.ok) {

    throw new Error(
      `TradingEconomics HTTP ${response.status}`
    );

  }


  const html =
    await response.text();


  const priceMatch =
    html.match(
      /id\s*=\s*["']market_last["'][^>]*>\s*([\d,]+\.?\d*)/i
    );


  const pctMatch =
    html.match(
      /id\s*=\s*["']market_daily_Pchg["'][^>]*>\s*([+-]?[\d.]+)\s*%/i
    );


  if (
    priceMatch &&
    pctMatch
  ) {

    return {

      price:
        priceMatch[1]
          .replace(/,/g, ""),

      changePercent:
        pctMatch[1],

      source:
        "TradingEconomics"

    };

  }


  throw new Error(
    "Could not parse Canola"
  );

}


