// ============================================================
// YAHOO FINANCE
// ============================================================

async function fetchCommodity(symbol) {

  const url =
    "https://query1.finance.yahoo.com/v8/finance/chart/" +
    encodeURIComponent(symbol) +
    "?interval=1d&range=1d";


  const response =
    await fetch(
      url,
      {
        headers: {
          "User-Agent":
            "Mozilla/5.0 CommodityBot/2.0",
          "Accept":
            "application/json"
        }
      }
    );


  if (!response.ok) {

    throw new Error(
      `Yahoo HTTP ${response.status} (${symbol})`
    );

  }


  const json =
    await response.json();


  const meta =
    json?.chart?.result?.[0]?.meta;


  if (!meta) {

    throw new Error(
      `No Yahoo metadata (${symbol})`
    );

  }


  const price =
    Number(
      meta.regularMarketPrice
    );


  const previousClose =
    Number(
      meta.chartPreviousClose ??
      meta.previousClose
    );


  if (
    !Number.isFinite(price) ||
    price <= 0
  ) {

    throw new Error(
      `Invalid price (${symbol})`
    );

  }


  if (
    !Number.isFinite(previousClose) ||
    previousClose <= 0
  ) {

    throw new Error(
      `Invalid previous close (${symbol})`
    );

  }


  const changePercent =
    (
      (price - previousClose) /
      previousClose
    ) * 100;


  return {

    price:
      price.toFixed(2),

    changePercent:
      changePercent.toFixed(2),

    symbol,

    source:
      "Yahoo Finance"

  };

}


// ============================================================
// FALLBACK
// ============================================================

async function fetchWithFallback(symbols) {

  const errors = [];


  for (
    const symbol of symbols
  ) {

    try {

      const data =
        await fetchCommodity(symbol);


      if (
        data &&
        Number(data.price) > 0
      ) {

        return data;

      }

    } catch (error) {

      errors.push(
        `${symbol}: ${getError(error)}`
      );

    }

  }


  throw new Error(
    errors.join(" | ")
  );

}


