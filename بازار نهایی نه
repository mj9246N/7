// ============================================================

async function processCommodities(env) {

  const kv =
    env[KV_NAMESPACE];

  if (!kv) {
    throw new Error(
      "COMMODITY_KV binding not found"
    );
  }


  let data;

  try {

    data =
      await fetchAllCommodities();

  } catch (error) {

    await handleError(
      env,
      kv,
      getError(error)
    );

    return;
  }


  const hash =
    JSON.stringify(data);


  const oldHash =
    (await kv.get("last_hash")) || "";


  if (hash === oldHash) {

    const errorStatus =
      await kv.get("error_status");

    if (errorStatus) {

      await sendTelegram(
        env,
        "✅ ارتباط با سایت دوباره برقرار شد."
      );

      await kv.put(
        "error_status",
        ""
      );

    }

    return;

  }


  const message =
    formatMessage(data);


  await sendTelegram(
    env,
    message,
    {
      parse_mode: "HTML",
      disable_web_page_preview: true
    }
  );


  await kv.put(
    "last_hash",
    hash
  );

}


